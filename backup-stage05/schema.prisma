  subject   String?  @db.VarChar(300)
  body      String   @db.Text
  variables Json     @default("[]") @db.JsonB
  status    String   @db.VarChar(10)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([code, channel, locale], map: "templates_code_channel_locale_key")
  @@map("templates")
  @@schema("notifications")
}

model Notification {
  id            String    @id @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  recipient     String?   @db.VarChar(320)
  channel       String    @db.VarChar(10)
  eventType     String    @map("event_type") @db.VarChar(60)
  payload       Json      @db.JsonB
  status        String    @db.VarChar(10)
  attempts      Int       @default(0)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  failureReason String?   @map("failure_reason") @db.Text
  correlationId String?   @map("correlation_id") @db.Uuid
  dedupeKey     String?   @unique(map: "notifications_dedupe_key_key") @map("dedupe_key") @db.VarChar(160)
  outboxEventId String?   @map("outbox_event_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User?     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, createdAt(sort: Desc)], where: raw("channel = 'in_app'"), map: "notifications_user_id_created_at_idx")
  @@index([status], map: "notifications_status_idx")
  @@map("notifications")
  @@schema("notifications")
}

