model Payment {
  id               String            @id @db.Uuid
  orderId          String            @map("order_id") @db.Uuid
  attemptNo        Int               @map("attempt_no") @db.SmallInt
  method           String            @db.VarChar(14)
  providerCode     String            @map("provider_code") @db.VarChar(30)
  status           String            @db.VarChar(10)
  amountIrr        Decimal           @map("amount_irr") @db.Decimal(18, 2)
  amountUsdt       Decimal?          @map("amount_usdt") @db.Decimal(20, 8)
  usdtRateId       String?           @map("usdt_rate_id") @db.Uuid
  idempotencyKey   String            @unique(map: "payments_idempotency_key_key") @map("idempotency_key") @db.VarChar(64)
  providerTxnRef   String?           @unique(map: "payments_provider_txn_ref_key") @map("provider_txn_ref") @db.VarChar(100)
  initiatedAt      DateTime          @default(now()) @map("initiated_at") @db.Timestamptz(6)
  verifiedAt       DateTime?         @map("verified_at") @db.Timestamptz(6)
  failedAt         DateTime?         @map("failed_at") @db.Timestamptz(6)
  failureReason    String?           @map("failure_reason") @db.Text
  callbackMetadata Json?             @map("callback_metadata") @db.JsonB
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  usdtRate         ExchangeRate?     @relation("PaymentUsdtRate", fields: [usdtRateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  successRecord    SucceededPayment? @relation("SuccessPaymentLineage")
  refunds          Refund[]          @relation("RefundPaymentLineage")

  @@unique([id, orderId], map: "payments_id_order_id_key")
  @@unique([orderId, attemptNo], map: "payments_order_id_attempt_no_key")
  @@unique([orderId], where: raw("status = 'succeeded'"), map: "payments_order_id_succeeded_key")
  @@index([orderId, status], map: "payments_order_id_status_idx")
  @@map("payments")
  @@schema("payments")
}

model SucceededPayment {
  paymentId     String   @id @map("payment_id") @db.Uuid
  orderId       String   @unique(map: "succeeded_payments_order_id_key") @map("order_id") @db.Uuid
  succeededAt   DateTime @map("succeeded_at") @db.Timestamptz(6)
  payment       Payment  @relation("SuccessPaymentLineage", fields: [paymentId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: Restrict)
  order         Order    @relation("SuccessOrderDirect", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pointerOrders Order[]  @relation("OrderPaymentPointer")

  @@unique([paymentId, orderId], map: "succeeded_payments_payment_id_order_id_key")
  @@map("succeeded_payments")
  @@schema("payments")
}

model Refund {
  id              String    @id @db.Uuid
  paymentId       String    @map("payment_id") @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  amountIrr       Decimal?  @map("amount_irr") @db.Decimal(18, 2)
  amountUsdt      Decimal?  @map("amount_usdt") @db.Decimal(20, 8)
  status          String    @db.VarChar(10)
  reason          String    @db.Text
  requestedBy     String?   @map("requested_by") @db.Uuid
  requestedAt     DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  executedAt      DateTime? @map("executed_at") @db.Timestamptz(6)
  providerRef     String?   @map("provider_ref") @db.VarChar(100)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  payment         Payment   @relation("RefundPaymentLineage", fields: [paymentId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: Restrict)
  requestedByUser User?     @relation("RefundRequester", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([paymentId], map: "refunds_payment_id_idx")
  @@map("refunds")
  @@schema("payments")
}

model CommissionRate {
  id            String    @id @db.Uuid
  ratePct       Decimal   @map("rate_pct") @db.Decimal(6, 3)
  validFrom     DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo       DateTime? @map("valid_to") @db.Timestamptz(6)
  note          String?   @db.Text
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUser User?     @relation("CommissionRateCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("commission_rates")
  // The single-current constant-expression partial unique index is migration-managed.
  @@schema("payments")
}

